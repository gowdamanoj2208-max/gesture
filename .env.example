# GestureLink AI Environment Configuration Example
# Copy to .env and adjust as needed

# Backend MQTT Broker Settings (Optional - leave empty for simulated mode)
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_TOPIC=gestureloop/gesture

# Hardware Mode Adapter:
# Set to 'true' only if an explicit adapter mapping is validated and physical ESP32 is deployed
HARDWARE_ADAPTER_ENABLED=false

# Frontend API Endpoint (optional, defaults to local proxy /api or http://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000
